# copy this to .env and fill in real values
# .env is git-ignored, never commit real credentials

# postgres connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://whispers:whispers_dev_password@localhost:5432/whispers_app

# ssl is auto-detected from the DATABASE_URL hostname (off for localhost, on
# otherwise). only set this if that guess is wrong -- e.g. a non-localhost
# hostname that's still plaintext postgres, like a docker-compose service name
# DATABASE_SSL=true

# port express listens on
PORT=5000

# comma separated list of origins allowed to hit the api
CORS_ORIGIN=http://localhost:5173

# max upload size in mb for audio/video clips
MAX_UPLOAD_MB=100

# where uploaded photos/clips get written. Leave unset for local dev (falls
# back to backend/uploads). In production, point this at a mounted
# persistent disk -- e.g. Render's Disks feature -- or every uploaded file
# is silently gone on the next redeploy, since the rest of the filesystem
# there is ephemeral.
# UPLOAD_DIR_PATH=/var/data/uploads

# --- auth / sessions ---
# no JWT signing secret here on purpose: sessions are opaque random tokens
# looked up (and revocable) in the `sessions` table, not signed/self-verifying
# JWTs, so there's nothing that needs a shared signing secret

# controls the session + csrf cookies' Secure/SameSite attributes.
# production (frontend on vercel, backend on render -- two different
# registrable domains) needs SameSite=None; Secure or the browser won't send
# the cookie cross-site at all. local dev over plain http can't set Secure
# cookies at all, so it needs SameSite=Lax instead.
# leave unset and it's inferred from NODE_ENV=production (mirrors DATABASE_SSL's
# "explicit override, else guess" pattern in db/pool.js). only set this
# explicitly if that guess is wrong for your deployment.
# COOKIE_SECURE=true

# --- email notifications (optional, fail-open) ---
# sent when someone joins your family via an invite code. leaving SMTP_HOST
# unset just logs and skips sending instead of erroring -- see lib/mailer.js.
# any real smtp provider works here (e.g. a free tier from Mailtrap, Resend,
# Brevo, or Gmail's smtp with an app password).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Whispers App <noreply@example.com>"
